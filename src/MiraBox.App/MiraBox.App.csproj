<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets/PixBuddy.ico</ApplicationIcon>
    <Product>小屏宝PixBuddy</Product>
    <AssemblyTitle>小屏宝PixBuddy</AssemblyTitle>
    <Description>小屏宝PixBuddy 屏幕内容管理与控制软件</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.14</Version>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/PixBuddy.ico" />
    <Content Include="Editor\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <InternalsVisibleTo Include="MiraBox.D92.OfflineChecks" />
    <ProjectReference Include="../MiraBox.Core/MiraBox.Core.csproj" />
    <ProjectReference Include="../../dependencies/DeskDisplay/src/DeskDisplay.Display/DeskDisplay.Display.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
  </ItemGroup>
</Project>
