<Window x:Class="MiraBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="D92 Studio · V7 开发版" Width="1280" Height="850" MinWidth="720" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WorkspaceBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" SizeChanged="ResizeShell">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="53" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0">
                <Border Width="29" Height="29" CornerRadius="9" Background="{DynamicResource BrandBrush}">
                    <TextBlock Text="D" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Studio" FontWeight="Bold" FontSize="18" Margin="9,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox x:Name="TopSearch" Style="{DynamicResource SearchBox}" MaxWidth="420" Tag="搜索资源名称（回车跳转资源库）"
                     HorizontalAlignment="Center" VerticalAlignment="Center" KeyDown="TopSearchKeyDown"
                     automation:AutomationProperties.Name="搜索资源名称" ToolTip="搜索资源名称，按 Enter"
                     shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ContentControl x:Name="HomeDeviceToolbar" VerticalAlignment="Center"/>
                <Button x:Name="HardwareTargetButton" Content="输出：模拟" Style="{DynamicResource SmallButton}"
                        Click="OpenHardwareTarget" Margin="0" ToolTip="选择模拟或 D92 实机输出"/>
                <ToggleButton x:Name="DemoToggle" Visibility="Collapsed" Content="演示模式" Style="{StaticResource DemoToggle}" Margin="8,0" Click="OpenDemoMode"/>
                <Popup PlacementTarget="{Binding ElementName=DemoToggle}" Placement="Bottom" StaysOpen="False"
                       IsOpen="{Binding IsChecked,ElementName=DemoToggle,Mode=TwoWay}" AllowsTransparency="True">
                    <Border Style="{DynamicResource Panel}" Margin="12" Padding="16">
                        <StackPanel MinWidth="220">
                            <TextBlock x:Name="ScenarioLabel" Text="演示场景" FontWeight="Bold" Margin="4,0,4,4"/>
                            <ComboBox x:Name="Scenario" Margin="4,0,4,12" SelectionChanged="ScenarioChanged"/>
                            <TextBlock x:Name="TargetLabel" Text="当前设备" FontWeight="Bold" Margin="4,0,4,4"/>
                            <ComboBox x:Name="Target" Margin="4,0,4,12" SelectionChanged="TargetChanged"/>
                            <ContentControl x:Name="ScenarioActions"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Style="{StaticResource WindowButton}" Content="—" Click="MinimizeWindow" ToolTip="最小化" automation:AutomationProperties.Name="最小化"/>
                <Button Style="{StaticResource WindowButton}" x:Name="MaximizeButton" Content="□" Click="MaximizeWindow" ToolTip="最大化或还原" automation:AutomationProperties.Name="最大化或还原"/>
                <Button Style="{StaticResource WindowCloseButton}" Content="×" Click="CloseWindow" ToolTip="关闭" automation:AutomationProperties.Name="关闭"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <DockPanel Background="White">
                <StackPanel x:Name="AccountNavigation" DockPanel.Dock="Bottom" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Navigation" Margin="0,10,0,12"/>
                </ScrollViewer>
            </DockPanel>
            <Border Grid.Column="1" x:Name="ContentPanel" Style="{DynamicResource WorkspacePanel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="Notice" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="24,12,24,0"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer x:Name="PageScroll" Grid.Row="1" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="Body" Margin="24,20,24,24"/>
                            <Border Height="{Binding ActualHeight, ElementName=OutputFooter}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, ElementName=PageScroll}" Value="Home">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="OutputFooter" Grid.Row="2" MinHeight="64" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <WrapPanel x:Name="PreviewBar"/>
                            <DockPanel x:Name="HardwareBar" Margin="16,6,16,0" Visibility="Collapsed">
                                <Button x:Name="HardwareStop" DockPanel.Dock="Right" Content="停止实机输出"
                                        Style="{DynamicResource SmallButton}" Click="StopHardwareFromFooter"/>
                                <Button x:Name="HardwareRestore" DockPanel.Dock="Right" Content="恢复壁纸"
                                        Style="{DynamicResource SmallButton}" Click="RestoreHardwareFromFooter" Visibility="Collapsed"/>
                                <Button x:Name="HardwareVideoPause" DockPanel.Dock="Right" Content="暂停视频"
                                        Style="{DynamicResource SmallButton}" Click="PauseHardwareVideoFromFooter" Visibility="Collapsed"/>
                                <Button x:Name="HardwarePause" DockPanel.Dock="Right" Content="暂停轮播切换"
                                        Style="{DynamicResource SmallButton}" Click="PauseHardwareFromFooter" Visibility="Collapsed"/>
                                <Button x:Name="HardwareNext" DockPanel.Dock="Right" Content="下一项"
                                        Style="{DynamicResource SmallButton}" Click="StepHardwareFromFooter" Visibility="Collapsed"/>
                                <Button x:Name="HardwarePrevious" DockPanel.Dock="Right" Content="上一项"
                                        Style="{DynamicResource SmallButton}" Click="StepHardwareFromFooter" Visibility="Collapsed"/>
                                <TextBlock x:Name="HardwareStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel Margin="12,8">
                                <Button x:Name="FooterChangeContent" DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}"
                                        Click="ChangeFooterContent" VerticalAlignment="Center" ToolTip="更换内容"
                                        automation:AutomationProperties.Name="更换内容">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="18" Height="18" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              Data="M2,3 H16 V15 H2 Z M3,12 L7,8 L10,11 L12,9 L16,13 M12,6 H13"/>
                                        <TextBlock x:Name="FooterChangeLabel" Text="更换内容" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <WrapPanel x:Name="Outputs" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,8"
                                Panel.ZIndex="1">
                        <Border x:Name="PlaylistToast" Visibility="Collapsed" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Background="{DynamicResource TintBrush}" CornerRadius="18" Padding="16,9" Margin="0,0,0,4"
                                BorderBrush="{DynamicResource PlaylistSelectionBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="PlaylistToastText" TextWrapping="Wrap" FontSize="13"
                                       automation:AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                        <ContentControl x:Name="PlaylistUndoBar" Visibility="Collapsed" HorizontalAlignment="Center">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="White" BorderBrush="{DynamicResource PlaylistSelectionBorderBrush}"
                                            BorderThickness="1" CornerRadius="18" Padding="14,0,8,0">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="CraftRuntimeHost" Grid.RowSpan="2" Width="1" Height="1" HorizontalAlignment="Left"
              VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0"/>
    </Grid>
</Window>
