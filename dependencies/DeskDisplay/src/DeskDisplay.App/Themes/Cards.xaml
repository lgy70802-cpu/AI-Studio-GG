<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DropShadowEffect x:Key="Effect.CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.06" Color="#6E86A8" />
    <Style x:Key="SoftCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource Effect.CardShadow}" />
    </Style>
    <Style x:Key="SoftCard.Flat" TargetType="Border" BasedOn="{StaticResource SoftCard}">
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
</ResourceDictionary>
