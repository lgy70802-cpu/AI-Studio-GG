<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#F5F7FB</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Primary">#4268EF</Color>
    <Color x:Key="Color.PrimarySoft">#EDF2FF</Color>
    <Color x:Key="Color.Text">#25314B</Color>
    <Color x:Key="Color.TextSecondary">#748198</Color>
    <Color x:Key="Color.Border">#E5EAF2</Color>
    <Color x:Key="Color.Success">#20C99A</Color>
    <Color x:Key="Color.Warning">#F4B860</Color>
    <Color x:Key="Color.Danger">#E56B76</Color>
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="{StaticResource Color.PrimarySoft}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Control" Color="#F0F4FA" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FCEDEF" />
    <SolidColorBrush x:Key="Brush.DangerText" Color="#B43949" />
</ResourceDictionary>
