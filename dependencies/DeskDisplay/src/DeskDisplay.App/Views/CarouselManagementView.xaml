<UserControl x:Class="DeskDisplay.App.Views.CarouselManagementView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:scene="clr-namespace:DeskDisplay.Display.Views;assembly=DeskDisplay.Display" xmlns:local="clr-namespace:DeskDisplay.App.Views" Background="Transparent">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Typography.xaml"/>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Cards.xaml"/>
 </ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></UserControl.Resources>
 <TabControl Style="{StaticResource SectionTabs}" Margin="32,28,32,24" SelectedIndex="{Binding CarouselSection}" SelectionChanged="CarouselTabChanged"><TabItem Header="壁纸轮播"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="切换到主题轮播" Click="SelectThemeTab" Style="{StaticResource SoftButton}" Margin="10,0,0,0"/><Button DockPanel.Dock="Right" Content="＋ 添加壁纸" Command="{Binding NavigateSectionCommand}" CommandParameter="我的资源" Style="{StaticResource PrimaryButton}"/><StackPanel><TextBlock Text="轮播管理" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="{Binding Creator.ThemePlaylistStatus}" Style="{StaticResource Text.Secondary}" Margin="0,5,0,0"/><TextBlock Text="{Binding Library.PlaylistLabel}" Style="{StaticResource Text.Secondary}" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Style="{StaticResource SoftCard}" Padding="18" Margin="0,0,0,16"><StackPanel><WrapPanel>
   <TextBlock Text="输出到" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,8,8"/>
   <ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding Library.RotationTargets}" SelectedItem="{Binding Library.RotationTarget}" IsEnabled="{Binding Library.CanChangeRotationTarget}" Width="145" Margin="0,0,18,8"/>
   <TextBlock Text="切换间隔" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,8,8"/>
   <ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding Library.Intervals}" SelectedItem="{Binding Library.IntervalSeconds}" Width="84" Margin="0,0,5,8"/><TextBlock Text="秒" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,18,8"/>
   <CheckBox Content="随机播放" IsChecked="{Binding Library.Shuffle}" VerticalAlignment="Center" Margin="0,0,18,8"/>
   <Button Content="上一张" Command="{Binding Library.PreviousCommand}" Style="{StaticResource SoftButton}" Margin="0,0,7,8"/>
   <Button Content="{Binding Library.RotationLabel}" Command="{Binding Library.RotationCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,8"/>
   <Button Content="下一张" Command="{Binding Library.NextCommand}" Style="{StaticResource SoftButton}" Margin="0,0,7,8"/>
   <Button Content="停止输出" Command="{Binding Library.StopCommand}" Style="{StaticResource SoftButton}" Margin="0,0,0,8"/>
  </WrapPanel>
  <WrapPanel Margin="0,8,0,8">
   <ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding Library.CarouselPresets}" SelectedItem="{Binding Library.SelectedPreset}" DisplayMemberPath="Name" IsEnabled="{Binding Library.CanChangeRotationTarget}" Width="150" Margin="0,0,8,0"/>
   <TextBox Text="{Binding Library.PresetName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,0"/>
   <Button Content="另存为新方案" Command="{Binding Library.CreatePresetCommand}" Style="{StaticResource SoftButton}"/>
   <Button Content="重命名" Command="{Binding Library.RenamePresetCommand}" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/>
   <Button Content="{Binding Library.CarouselPauseLabel}" Command="{Binding Library.CarouselPauseCommand}" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/>
  </WrapPanel>
  <WrapPanel><TextBlock Text="{Binding Library.CarouselPlaybackStatus}" Margin="0,0,18,0"/><TextBlock Text="{Binding Library.CarouselCurrent}" Margin="0,0,18,0"/><TextBlock Text="{Binding Library.CarouselNext}" Margin="0,0,18,0"/><TextBlock Text="{Binding Library.CarouselCountdown}"/></WrapPanel>
  <Expander Header="批量添加本地壁纸（Ctrl / Shift 多选）" Margin="0,12,0,0"><StackPanel><ListBox x:Name="Candidates" ItemsSource="{Binding Library.CarouselCandidates}" DisplayMemberPath="Name" SelectionMode="Extended" Height="130"/><Button Content="加入所选资源" Click="AddSelected" HorizontalAlignment="Left" Style="{StaticResource SoftButton}"/></StackPanel></Expander>
  </StackPanel></Border>
  <Grid Grid.Row="2">
   <Border Style="{StaticResource SoftCard.Flat}" Visibility="{Binding Library.HasPlaylistItems, Converter={StaticResource Visible}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="移出所选" Click="RemoveSelected" Style="{StaticResource SoftButton}" Margin="0,0,8,0"/><Button Content="向前移动" Command="{Binding Library.MoveUpCommand}" Style="{StaticResource SoftButton}"/><Button Content="向后移动" Command="{Binding Library.MoveDownCommand}" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/></StackPanel><TextBlock Text="播放顺序" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/></DockPanel>
    <ListBox x:Name="Playlist" SelectionMode="Extended" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" Drop="DropItem" Grid.Row="1" ItemsSource="{Binding Library.PlaylistItems}" SelectedItem="{Binding Library.PlaylistSelection}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,14,14"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="#F7F9FC" CornerRadius="10" Padding="0" ClipToBounds="True"><StackPanel><scene:PreviewHost AspectRatio="4"><Border Background="#152239" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border></scene:PreviewHost><DockPanel Margin="14,11,12,12"><Button DockPanel.Dock="Right" Content="移出轮播" Command="{Binding DataContext.Library.PlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SoftButton}" VerticalAlignment="Center" Margin="12,0,0,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CarouselCategory}" Style="{StaticResource Text.Secondary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></Border>
   <Border Style="{StaticResource SoftCard}" Visibility="{Binding Library.IsPlaylistEmpty, Converter={StaticResource Visible}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▶" FontSize="34" Foreground="{StaticResource Brush.Primary}" HorizontalAlignment="Center"/><TextBlock Text="轮播列表为空" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/><TextBlock Text="前往我的资源库，打开壁纸详情并选择“加入轮播”。" Style="{StaticResource Text.Secondary}" Margin="0,7,0,16"/><Button Content="前往我的资源库" Command="{Binding NavigateSectionCommand}" CommandParameter="我的资源" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource SoftCard.Flat}" Margin="0,14,0,0"><TextBlock Text="{Binding Library.Status}" Style="{StaticResource Text.Secondary}"/></Border>
 </Grid></TabItem><TabItem Header="主题轮播"><ContentControl x:Name="ThemePlaylistHost"/></TabItem><TabItem Header="混合轮播"><local:MixedPlaylistView DataContext="{Binding MixedPlaylist}"/></TabItem></TabControl>
</UserControl>

