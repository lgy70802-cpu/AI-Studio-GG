<Window x:Class="DeskDisplay.App.Views.CreatorCropEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:scene="clr-namespace:DeskDisplay.Display.Views;assembly=DeskDisplay.Display" Title="图片裁剪" Width="920" Height="620" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Typography.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="图片裁剪" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,16"/>
 <scene:PreviewHost x:Name="Host" Grid.Row="1"><Canvas x:Name="Viewport" Background="#152239" ClipToBounds="True" SizeChanged="Refresh" MouseLeftButtonDown="Down" MouseMove="Move" MouseLeftButtonUp="Up"><Image x:Name="Picture" Stretch="Fill" IsHitTestVisible="False"/></Canvas></scene:PreviewHost>
 <WrapPanel Grid.Row="2" Margin="0,16,0,0" VerticalAlignment="Center"><TextBlock Text="缩放" VerticalAlignment="Center"/><Slider x:Name="ZoomSlider" Minimum="1" Maximum="8" Width="180" ValueChanged="ZoomChanged" Margin="12,0"/><Button Content="重置裁剪" Click="Reset" Style="{StaticResource SoftButton}"/><Button Content="恢复原比例" Click="OriginalAspect" Style="{StaticResource SoftButton}" Margin="8,0"/><Button Content="取消" IsCancel="True" Style="{StaticResource SoftButton}"/><Button Content="应用裁剪" Click="Apply" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></WrapPanel>
 </Grid>
</Window>
