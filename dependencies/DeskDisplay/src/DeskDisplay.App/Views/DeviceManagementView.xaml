<UserControl x:Class="DeskDisplay.App.Views.DeviceManagementView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:DeskDisplay.App.Views" Background="Transparent">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Cards.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="32,28,32,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="设备列表" Click="ShowDeviceList" Style="{StaticResource SoftButton}"/>
    <Button Content="原有 D92 USB 输出" Click="ShowUsbOutput" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/>
   </StackPanel>
   <TextBlock Text="设备管理" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <views:ManagedDevicePanel DataContext="{Binding Devices}">
    <views:ManagedDevicePanel.Style><Style TargetType="views:ManagedDevicePanel"><Setter Property="Visibility" Value="Collapsed"/>
     <Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedNavigation, ElementName=Root}" Value="设备"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style></views:ManagedDevicePanel.Style>
   </views:ManagedDevicePanel>
   <Border Padding="18">
    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SoftCard}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedNavigation}" Value="USB屏"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <views:UsbOutputView DataContext="{Binding Usb}"/>
   </Border>
  </Grid>
 </Grid>
</UserControl>
