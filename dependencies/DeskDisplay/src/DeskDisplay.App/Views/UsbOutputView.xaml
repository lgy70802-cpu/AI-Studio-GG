<UserControl x:Class="DeskDisplay.App.Views.UsbOutputView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:scene="clr-namespace:DeskDisplay.Display.Views;assembly=DeskDisplay.Display"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="VideoCustomVisibility"/></ResourceDictionary></UserControl.Resources>
 <Grid Margin="0,20,0,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="USB 直连屏幕" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="退出 Craft 后开始。支持时钟、图片、性能和独立视频。视频目标最高30 FPS、静音循环；实际帧率取决于素材与设备吞吐。" TextWrapping="Wrap" Foreground="#65748A" Margin="0,10,0,16"/>
   <StackPanel IsEnabled="{Binding CanEdit}">
    <WrapPanel Margin="0,0,0,12"><TextBlock Text="视频模式" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding VideoModeOptions}" SelectedItem="{Binding VideoMode}" Width="130" AutomationProperties.Name="D92视频模式"/><TextBlock Text="{Binding VideoModeSummary}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel><WrapPanel Visibility="{Binding IsCustomVideoMode, Converter={StaticResource VideoCustomVisibility}}" Margin="0,0,0,12"><TextBlock Text="视频目标帧率" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Style="{DynamicResource SoftSelector}" IsEnabled="{Binding IsCustomVideoMode}" ItemsSource="{Binding VideoFpsOptions}" SelectedItem="{Binding VideoFps}" Width="100" AutomationProperties.Name="D92视频目标FPS"/><TextBlock Text="FPS · 按设备记忆" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#65748A"/><CheckBox IsEnabled="{Binding IsCustomVideoMode}" Content="持续低帧率时自动降档" IsChecked="{Binding AutoReduceVideoFps}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="连续5个一秒窗口低于当前上限80%时按30→24→20→10→5降低一档；不降低JPEG画质，下次播放恢复所选目标。"/></WrapPanel>
    <WrapPanel Visibility="{Binding IsCustomVideoMode, Converter={StaticResource VideoCustomVisibility}}" Margin="0,0,0,12"><TextBlock Text="视频 JPEG 质量" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Style="{DynamicResource SoftSelector}" IsEnabled="{Binding IsCustomVideoMode}" ItemsSource="{Binding VideoQualityOptions}" SelectedItem="{Binding VideoJpegQuality}" Width="100" AutomationProperties.Name="D92视频JPEG质量"/><TextBlock Text="默认90；降低可减少编码和传输开销，下次播放生效" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#65748A"/></WrapPanel>
    <TextBlock Text="目标 D92（按设备序列号识别）" Margin="0,0,0,6"/>
    <DockPanel><Button Style="{DynamicResource SoftButton}" DockPanel.Dock="Right" Content="刷新设备" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/><ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedSerial}" AutomationProperties.Name="USB目标设备"/></DockPanel>
    <WrapPanel Margin="0,12,0,0">
     <StackPanel Margin="0,0,16,0"><TextBlock Text="画布宽度（像素）" Margin="0,0,0,6"/><TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="USB画布宽度"/></StackPanel>
     <StackPanel Margin="0,0,16,0"><TextBlock Text="画布高度（像素）" Margin="0,0,0,6"/><TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="USB画布高度"/></StackPanel>
     <StackPanel><TextBlock Text="屏幕旋转（度）" Margin="0,0,0,6"/><ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding Rotations}" SelectedItem="{Binding Rotation}" Width="150" AutomationProperties.Name="USB屏幕旋转"/></StackPanel>
    </WrapPanel>
   </StackPanel>
   <WrapPanel Margin="0,16,0,10"><Button Style="{DynamicResource SoftButton}" Content="保存并开始 USB 显示" Command="{Binding StartCommand}" Background="#FFD21C" Margin="0,0,12,0"/><Button Style="{DynamicResource SoftButton}" Content="停止 USB 显示" Command="{Binding StopCommand}"/></WrapPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#345C85" AutomationProperties.Name="USB输出状态"/>
   <TextBlock Text="{Binding VideoPerformanceText}" TextWrapping="Wrap" Foreground="#65748A" Margin="0,6,0,0"/>
  </StackPanel>
  <scene:PreviewHost Grid.Row="1" AspectRatio="{Binding Scene.AspectRatio}" Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
   <scene:SceneView Scene="{Binding Scene}"/>
  </scene:PreviewHost>
  <TextBlock Grid.Row="2" Text="运行时跟随当前预览场景。断开后等待同一设备重连；停止后屏幕可能保留最后一帧。USB 直连不会创建 Windows 扩展桌面。" TextWrapping="Wrap" Foreground="#65748A"/>
 </Grid>
</UserControl>
