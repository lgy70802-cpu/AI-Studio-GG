                    <TextBlock Text="透明度（0—1）" Style="{StaticResource Text.Secondary}" />
                    <local:NumericStepper Value="{Binding BatchOpacity}" Minimum="0" Maximum="1" Step="0.1" />
                    <Button Content="统一透明度" Command="{Binding BatchCommand}" CommandParameter="opacity" Style="{StaticResource SoftButton}" />
                    <StackPanel Visibility="{Binding SupportsSharedColor, Converter={StaticResource Visible}}">
                      <ComboBox ItemsSource="{Binding ColorPresets}" IsEditable="True" Text="{Binding BatchColor}" Margin="0,8,0,0" />
                      <Button Content="统一颜色" Command="{Binding BatchCommand}" CommandParameter="color" Style="{StaticResource SoftButton}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SupportsSharedFont, Converter={StaticResource Visible}}">
                      <TextBox Text="{Binding BatchFont}" ToolTip="字体名称（仅文字与时钟类）" Margin="0,8,0,0" />
                      <local:NumericStepper Value="{Binding BatchFontSize}" Minimum="1" Maximum="2000" />
                      <Button Content="统一字体与字号" Command="{Binding BatchCommand}" CommandParameter="font" Style="{StaticResource SoftButton}" />
                    </StackPanel>
                    <WrapPanel>
                      <Button Content="锁定所选" Command="{Binding BatchCommand}" CommandParameter="lock" Style="{StaticResource SoftButton}" />
                      <Button Content="解锁所选" Command="{Binding BatchCommand}" CommandParameter="unlock" Style="{StaticResource SoftButton}" />
                    </WrapPanel>
                  </StackPanel>
                </Expander>
                <TextBlock Text="锁定图层不参与修改" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" />
              </StackPanel>
              <StackPanel Visibility="{Binding IsSingleSelection, Converter={StaticResource Visible}}">

                <StackPanel IsEnabled="{Binding CanEditSelection}">



                  <Expander Header="时钟设置" IsExpanded="True" Margin="0,0,0,10" Visibility="{Binding IsClock, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="数字样式" Style="{StaticResource Label}"/><ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding ClockAppearanceChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClockAppearance}"/><TextBlock Text="{Binding ClockFaceHint}" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,5"/><UniformGrid Columns="2" IsEnabled="{Binding SupportsClockFont}"><ComboBox Style="{DynamicResource SoftSelector}" ToolTip="字重" ItemsSource="{Binding ClockWeights}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClockWeight}" Margin="0,0,4,0"/><ComboBox Style="{DynamicResource SoftSelector}" ToolTip="字形宽度" ItemsSource="{Binding ClockStretches}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClockStretch}"/></UniformGrid><TextBlock Text="时间格式" Style="{StaticResource Label}" />
                      <ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" />
                      <CheckBox Content="12小时制" IsChecked="{Binding Hour12}" Margin="0,10,0,8" />
                      <CheckBox Content="显示秒钟" IsChecked="{Binding ShowSeconds}" />
                      <TextBlock Text="样式名称（沿用图层名）" Style="{StaticResource Label}"/><TextBox Text="{Binding LayerName, UpdateSourceTrigger=LostFocus}" MaxLength="80" Style="{StaticResource Field}"/><Button Content="保存为我的时钟样式" Command="{Binding SaveClockStyleCommand}" Style="{StaticResource SoftButton}" Margin="0,10,0,0" ToolTip="以当前图层名称保存字体、样式和时间设置，不保存背景或其他图层"/><Button Content="适应内容" Command="{Binding FitClockContentCommand}" Style="{StaticResource SoftButton}" Margin="0,10,0,0" ToolTip="按当前字体和时间格式收紧边框，保留中心位置；秒数变化不会改变边框" />
                    </StackPanel>
                  </Expander>
                  <Expander Header="外观" IsExpanded="True" Margin="0,0,0,10">
                    <StackPanel>
                      <DockPanel Margin="0,4,0,8"><TextBlock Text="透明度" VerticalAlignment="Center"/><TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"/><Slider Value="{Binding Opacity}" Minimum="0" Maximum="1" Margin="8,0"/></DockPanel>
                      <StackPanel Visibility="{Binding ShowColor, Converter={StaticResource Visible}}">
                        <TextBlock Text="颜色" Style="{StaticResource Label}" />
<DockPanel Margin="0,4,0,8"><Button Width="30" Height="28" Padding="0" Background="{Binding Color}" Click="PickColor" ToolTip="选择颜色" Style="{StaticResource SoftButton}"/><ComboBox ItemsSource="{Binding ColorPresets}" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged, Delay=120}" IsEditable="True" Margin="6,0,0,0" ToolTip="颜色值 #RRGGBB / #AARRGGBB"/></DockPanel>
                      </StackPanel>
                    </StackPanel>
                  </Expander>
                  <Expander Header="文字样式" IsExpanded="True" Margin="0,0,0,10" Visibility="{Binding IsText, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <StackPanel Visibility="{Binding IsLiteralText, Converter={StaticResource Visible}}">
                        <TextBlock Text="文字" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=120}" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="140" VerticalScrollBarVisibility="Auto"/><TextBlock Text="{Binding TextOverflowHint}" Foreground="#BA6947" TextWrapping="Wrap" FontSize="11"/><WrapPanel><CheckBox Content="自动增高" IsChecked="{Binding AutoGrowTextHeight}" VerticalAlignment="Center"/><Button Content="适应文字高度" Command="{Binding FitTextHeightCommand}" Style="{StaticResource SoftButton}" Padding="6,4" Margin="6,0,0,0"/></WrapPanel><TextBlock Text="垂直对齐" Style="{StaticResource Label}"/><ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding TextVerticalChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TextVerticalAlignment}"/>
                      </StackPanel>
                      <TextBlock Text="字体" Style="{StaticResource Label}" />
                      <ComboBox IsEnabled="{Binding SupportsClockFont}" ItemsSource="{Binding Fonts}" Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged, Delay=180}" IsEditable="True" IsTextSearchEnabled="True" ToolTip="已安装字体；输入可搜索" />

                      <TextBlock Text="字号" Style="{StaticResource Label}" />
                      <local:NumericStepper Value="{Binding FontSize}" Minimum="1" Maximum="2000" />
                      <CheckBox IsEnabled="{Binding SupportsClockFont}" Content="粗体" IsChecked="{Binding Bold}" />
                      <TextBlock Text="对齐" Style="{StaticResource Label}" />
                      <ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment}" />
                      <Expander Header="更多文字设置" Margin="0,8,0,0"><StackPanel><TextBlock Text="字符间距" Style="{StaticResource Label}" />
                      <local:NumericStepper Value="{Binding Spacing}" Minimum="-200" Maximum="200" />
                      <CheckBox Content="文字阴影" IsChecked="{Binding Shadow}" /></StackPanel></Expander>
                    </StackPanel>
                  </Expander>

                  <Expander Header="图片设置" IsExpanded="True" Margin="0,0,0,10" Visibility="{Binding IsImage, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <Button Content="替换图片" Click="BrowseMaterials" Style="{StaticResource SoftButton}" Margin="0,0,0,6"/>
                      <TextBlock Text="填充方式" Style="{StaticResource Label}" />
                      <ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding FillChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Fill}" />
                      <Button Content="裁剪图片" Command="{Binding CropImageCommand}" Style="{StaticResource SoftButton}" Margin="0,8,0,6"/>
                      <Expander Header="裁剪与亮度" Margin="0,4,0,6"><StackPanel>
                        <Button Content="重置裁剪" Command="{Binding ResetImageCropCommand}" Style="{StaticResource SoftButton}" Margin="0,0,0,6"/>
                        <TextBlock Text="裁剪水平位置" Style="{StaticResource Label}" />
                        <Slider Value="{Binding CropX}" Minimum="0" Maximum="1" />
                        <TextBlock Text="裁剪垂直位置" Style="{StaticResource Label}" />
                        <Slider Value="{Binding CropY}" Minimum="0" Maximum="1" />
                        <TextBlock Text="亮度" Style="{StaticResource Label}" />
                        <Slider Value="{Binding Brightness}" Minimum="0" Maximum="1" />
                      </StackPanel></Expander>
                      <Expander Header="素材信息" Margin="0,4,0,0"><StackPanel><TextBlock Text="素材来源" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding AssetSource}" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}" />
                      </StackPanel></Expander>
                    </StackPanel>
                  </Expander>
                  <Expander Header="位置与尺寸" IsExpanded="False" Margin="0,8,0,10">
                    <StackPanel>
                      <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,5,0">
                          <TextBlock Text="X" Style="{StaticResource Label}" />
                          <local:NumericStepper Value="{Binding X}" Minimum="-32768" Maximum="32768" />
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="Y" Style="{StaticResource Label}" />
                          <local:NumericStepper Value="{Binding Y}" Minimum="-32768" Maximum="32768" />
                        </StackPanel>
                        <StackPanel Margin="0,0,5,0">
                          <TextBlock Text="宽" Style="{StaticResource Label}" />
                          <local:NumericStepper Value="{Binding Width}" Minimum="1" Maximum="16384" />
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="高" Style="{StaticResource Label}" />
                          <local:NumericStepper Value="{Binding Height}" Minimum="1" Maximum="16384" />
                        </StackPanel>
                      </UniformGrid>
                      <CheckBox Content="锁定宽高比例" IsChecked="{Binding LockAspect}" Margin="0,6,0,4" />
                      <TextBlock Text="旋转角度" Style="{StaticResource Label}" />
                      <local:NumericStepper Value="{Binding Rotation}" Minimum="-360" Maximum="360" />
                      <Button Content="在画布中居中" Command="{Binding CenterLayerCommand}" Style="{StaticResource SoftButton}" />
                    </StackPanel>
                  </Expander>
                  <Expander Header="更多设置" Margin="0,0,0,8"><StackPanel><WrapPanel><Button Content="复制样式" Command="{Binding CopyStyleCommand}" Style="{StaticResource SoftButton}"/><Button Content="粘贴样式" Command="{Binding PasteStyleCommand}" Style="{StaticResource SoftButton}"/></WrapPanel><TextBlock Text="名称" Style="{StaticResource Label}"/>
                  <TextBox Text="{Binding LayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" Style="{StaticResource Field}" /><CheckBox Content="显示图层" IsChecked="{Binding Visible}" Margin="0,6,0,0"/></StackPanel></Expander>
                </StackPanel>
              </StackPanel>
              </StackPanel></ScrollViewer><ScrollViewer x:Name="CanvasProperties" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="当前画布" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10"/><Expander Header="项目信息" Margin="0,0,0,10"><StackPanel><TextBlock Text="主题分类" Style="{StaticResource Label}"/><TextBox Text="{Binding ProjectCategory, UpdateSourceTrigger=LostFocus}" MaxLength="80" Style="{StaticResource Field}"/></StackPanel></Expander>
                <TextBlock Text="宽度（设计单位）" Style="{StaticResource Label}" />
                <local:NumericStepper Value="{Binding CanvasWidth}" Minimum="1" Maximum="8192" ToolTip="设计宽度" />
                <TextBlock Text="高度（设计单位）" Style="{StaticResource Label}" />
                <local:NumericStepper Value="{Binding CanvasHeight}" Minimum="1" Maximum="8192" ToolTip="设计高度" />
                <Button Content="选择 / 替换背景图片" Click="PickBackgroundImage" Style="{StaticResource SoftButton}" Margin="0,8,0,4"/><TextBlock Text="背景颜色" Style="{StaticResource Label}" />
                <TextBox Text="{Binding CanvasBackground, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Field}" />
                <TextBlock Text="修改画布不会拉伸图层。" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,8,0,0" />
              <Expander Header="布局管理" Margin="6,4,0,0">
                <StackPanel>
                  <TextBox Style="{StaticResource Field}" Text="{Binding LayoutName, UpdateSourceTrigger=LostFocus}" MaxLength="80" ToolTip="自定义布局名称" />

                </StackPanel>
              </Expander></StackPanel>

          </ScrollViewer></Grid></DockPanel>
        </Border>
      </Grid>
    </Grid>
    <Grid Visibility="{Binding IsPreview, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16">
        <Button Content="按设备预览与应用" Click="OpenDevicePreview" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" />
        <Button Content="‹ 返回编辑" Command="{Binding EditCommand}" Style="{StaticResource SoftButton}" DockPanel.Dock="Left" />
        <TextBlock Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Text.PageTitle}" Margin="16,0" />
      </DockPanel>
      <scene:PreviewHost Grid.Row="1" AspectRatio="{Binding Aspect}">
        <scene:SceneView Scene="{Binding Scene}" AspectRatioOverride="{Binding Aspect}" />
      </scene:PreviewHost>
      <Border Grid.Row="2" Style="{StaticResource SoftCard.Flat}" Margin="0,16,0,0">
        <StackPanel>
          <WrapPanel>
            <Button Content="横屏" Click="Landscape" Style="{StaticResource LandscapeMode}" />
            <Button Content="竖屏" Click="Portrait" Style="{StaticResource PortraitMode}" />
            <ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding OutputTargets}" SelectedItem="{Binding OutputTarget}" Width="130" Margin="12,0" />
            <TextBlock Text="{Binding DeviceStatus}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="设备设置" Click="DeviceSettings" Style="{StaticResource SoftButton}" />
            <Button Content="保存主题" Command="{Binding SaveCommand}" Style="{StaticResource SoftButton}" Margin="12,0" />
            <Button Content="应用到设备" Command="{Binding ConfirmApplyCommand}" Style="{StaticResource PrimaryButton}" />
          </WrapPanel>
          <StackPanel Visibility="{Binding IsUsbTarget, Converter={StaticResource Visible}}" Margin="0,10,0,0">
            <ComboBox ItemsSource="{Binding Usb.Devices}" SelectedItem="{Binding Usb.SelectedSerial}" IsEnabled="{Binding Usb.CanEdit}" Width="260" HorizontalAlignment="Left" ToolTip="已识别的 D92 设备">
              <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource SoftSelector}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Usb.Devices.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Usb}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ComboBox.Style>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="{Binding EffectiveUsbGeometry}" Visibility="{Binding IsUsbTarget, Converter={StaticResource Visible}}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="{Binding OutputCheck}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0" />
          <TextBlock Text="{Binding Capability}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </Grid>
    <DockPanel Grid.Row="1" Margin="0,10,0,0">

      <StackPanel DockPanel.Dock="Right" Visibility="{Binding ShowSaveState, Converter={StaticResource Visible}}" Margin="16,0,0,0" HorizontalAlignment="Right">
        <TextBlock Text="{Binding SaveFeedback}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding DraftFeedback}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Right" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
    </DockPanel>
  </Grid>
</UserControl>






