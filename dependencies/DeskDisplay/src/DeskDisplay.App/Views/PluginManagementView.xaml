<UserControl x:Class="DeskDisplay.App.Views.PluginManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:scene="clr-namespace:DeskDisplay.Display.Views;assembly=DeskDisplay.Display" Background="Transparent">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Typography.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Cards.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="32,28,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><Border DockPanel.Dock="Right" Background="{StaticResource Brush.PrimarySoft}" CornerRadius="10" Padding="12,6"><TextBlock Text="2 个内置插件" Foreground="{StaticResource Brush.Primary}"/></Border><StackPanel><TextBlock Text="插件中心" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="启用、配置、预览并输出到 D92" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,14"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="查看" Command="{Binding Plugins.SelectCameraCommand}" Style="{StaticResource SoftButton}"/><Border Width="44" Height="44" CornerRadius="10" Background="#EAF3ED" Margin="0,0,12,0"><TextBlock Text="相" Foreground="#31513D" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="复古相机翻页时钟" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1.0 · 内置 · D92" Style="{StaticResource Text.Secondary}"/></StackPanel></DockPanel><TextBlock Text="摄影质感底图与五联机械翻牌。仅使用本地时间，不访问网络。" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}" Margin="0,13,0,12"/><CheckBox Content="启用插件" IsChecked="{Binding Plugins.CameraEnabled}" Margin="0,0,0,10"/><WrapPanel><CheckBox Content="翻页动画" IsChecked="{Binding Plugins.CameraAnimate}" Margin="0,0,18,8"/><CheckBox Content="12 小时制" IsChecked="{Binding Plugins.CameraHour12}" Margin="0,0,0,8"/></WrapPanel><Grid Margin="0,2,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="95"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox Style="{DynamicResource SoftSelector}" Grid.Column="1" ItemsSource="{Binding Plugins.CameraDurations}" SelectedItem="{Binding Plugins.CameraDuration}"/><TextBlock Grid.Column="3" Text="位置" VerticalAlignment="Center" Margin="0,0,7,0"/><Slider Grid.Column="4" Minimum="80" Maximum="230" Value="{Binding Plugins.CameraCropY}"/></Grid><WrapPanel><Button Content="保存" Command="{Binding Plugins.SaveCameraCommand}" Style="{StaticResource SoftButton}" Margin="0,0,7,7"/><Button Content="演示" Command="{Binding Plugins.DemoCameraCommand}" Style="{StaticResource SoftButton}" Margin="0,0,7,7"/><Button Content="预览" Command="{Binding Plugins.PreviewCameraCommand}" Style="{StaticResource SoftButton}" Margin="0,0,7,7"/><Button Content="显示到 D92" Command="{Binding Plugins.ApplyCameraUsbCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,7"/></WrapPanel><TextBlock Text="{Binding Plugins.CameraMessage}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Style="{StaticResource SoftCard}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="查看" Command="{Binding Plugins.SelectStockCommand}" Style="{StaticResource SoftButton}"/><Border Width="44" Height="44" CornerRadius="10" Background="#EEF1F7" Margin="0,0,12,0"><TextBlock Text="股" Foreground="#16233B" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="{Binding Plugins.Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Plugins.Version}" Style="{StaticResource Text.Secondary}"/></StackPanel></DockPanel><TextBlock Text="{Binding Plugins.Description}" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}" Margin="0,13,0,12"/><CheckBox Content="启用插件" IsChecked="{Binding Plugins.Enabled}" Margin="0,0,0,10"/><TextBox Text="{Binding Plugins.Symbols, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" ToolTip="1–20 个 A 股代码"/><WrapPanel Margin="0,12,0,0"><Button Content="保存" Command="{Binding Plugins.SaveCommand}" Style="{StaticResource SoftButton}" Margin="0,0,7,7"/><Button Content="刷新行情" Command="{Binding Plugins.RefreshCommand}" Style="{StaticResource SoftButton}" Margin="0,0,7,7"/><Button Content="预览" Command="{Binding Plugins.PreviewCommand}" Style="{StaticResource SoftButton}" Margin="0,0,7,7"/><Button Content="显示到 D92" Command="{Binding Plugins.ApplyUsbCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,7"/></WrapPanel><TextBlock Text="{Binding Plugins.Message}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="2" Background="#111A29" CornerRadius="12" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding Plugins.ActivePluginTitle}" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="1920 × 462 · D92" Foreground="#8C9AB1"/></DockPanel><scene:PreviewHost Grid.Row="1" AspectRatio="4.155844155844156" VerticalAlignment="Center"><scene:SceneView Scene="{Binding Plugins.ActiveScene}"/></scene:PreviewHost><TextBlock Grid.Row="2" Text="插件按设备刷新能力显示，使用实时数据渲染。" Foreground="#8C9AB1" Margin="0,12,0,0"/></Grid></Border>
  </Grid>
 </Grid>
</UserControl>
