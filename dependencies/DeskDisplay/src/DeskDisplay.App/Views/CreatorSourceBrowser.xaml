<Window x:Class="DeskDisplay.App.Views.CreatorSourceBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:scene="clr-namespace:DeskDisplay.Display.Views;assembly=DeskDisplay.Display" Width="1040" Height="660" MinWidth="700" MinHeight="420" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Typography.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Cards.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock x:Name="Heading" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,16"/>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <ListBox x:Name="Sources" SelectionChanged="SelectSource" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Foreground="#8C9AB1" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 <Grid Grid.Column="1" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><scene:PreviewHost x:Name="SourcePreview" AspectRatio="{Binding Aspect}"><scene:SceneView Scene="{Binding Scene}" AspectRatioOverride="{Binding Aspect}"/></scene:PreviewHost><TextBlock Grid.Row="1" x:Name="Feedback" Foreground="#8C9AB1" TextWrapping="Wrap" Margin="0,10,0,0"/></Grid>
 </Grid>
 <StackPanel Grid.Row="2"><WrapPanel x:Name="Manage" Visibility="Collapsed" Margin="0,10,0,0"><TextBox x:Name="TemplateName" Width="220" MaxLength="160" Padding="8"/><Button Content="重命名" Click="Rename" Style="{StaticResource SoftButton}" Margin="8,0"/><Button Content="删除模板" Click="Delete" Style="{StaticResource SoftButton}"/></WrapPanel><DockPanel Margin="0,16,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" IsCancel="True" Style="{StaticResource SoftButton}" Margin="0,0,10,0"/><Button x:Name="UseButton" Click="UseSource" IsEnabled="False" Style="{StaticResource PrimaryButton}"/></StackPanel><TextBlock Text="创建独立副本；素材仍引用现有资源库。" Foreground="#8C9AB1" VerticalAlignment="Center"/></DockPanel></StackPanel>
 </Grid>
</Window>
