<Window x:Class="DeskDisplay.App.Views.CreatorDevicePreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:scene="clr-namespace:DeskDisplay.Display.Views;assembly=DeskDisplay.Display" Title="完成并使用" Width="1160" Height="780" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#F4F7FB" Foreground="#202C43" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Typography.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Cards.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><Button Content="{Binding ReturnLabel}" Click="ClosePreview" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SoftButton}"/><TextBlock Text="{Binding ThemeName}" Style="{StaticResource Text.PageTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
  <Border Grid.Row="1" Style="{StaticResource SoftCard.Flat}" Padding="12" Margin="0,0,0,12"><StackPanel>
   <WrapPanel IsEnabled="{Binding CanConfigure}"><TextBlock Text="使用到" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Width="380" Style="{StaticResource SoftSelector}" ItemsSource="{Binding Devices}" SelectedItem="{Binding Target}" DisplayMemberPath="PreviewLabel" AutomationProperties.AutomationId="CreatorPreviewDevice"/><TextBlock Text="{Binding Target.ConnectionStatus}" Foreground="#8C9AB1" VerticalAlignment="Center" Margin="12,0"/><Button Content="停止输出" Command="{Binding Target.StopCommand}" Style="{StaticResource SoftButton}"/></WrapPanel>
   <CheckBox x:Name="TargetConfirmation" IsChecked="{Binding Target.Confirmed}" IsEnabled="{Binding Target.CanConfirm}" Content="已核对此设备与参数" Margin="0,10,0,0" Visibility="{Binding NeedsConfirmation, Converter={StaticResource Visible}}"/>
   <TextBlock Text="{Binding Geometry}" Foreground="#8C9AB1" Margin="0,8,0,0"/><TextBlock Text="{Binding Match}" Foreground="#8C9AB1" Margin="0,4,0,0"/>
  </StackPanel></Border>
  <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Expander x:Name="AdaptationOptions" Header="画面适配" IsEnabled="{Binding CanConfigure}" Margin="0,0,12,0"><StackPanel Margin="0,8,0,0"><ComboBox Style="{StaticResource SoftSelector}" ItemsSource="{Binding Adaptations}" SelectedItem="{Binding Adaptation}" DisplayMemberPath="Name"/><TextBlock Text="{Binding Target.IdentityStatus}" Foreground="#8C9AB1" Margin="0,6,0,0"/><TextBlock Text="{Binding Target.Rotation, StringFormat=传输旋转：{0}°}" Foreground="#8C9AB1"/><WrapPanel Margin="0,8,0,0"><Button Content="保存为布局并微调" Click="EditAdaptation" IsEnabled="{Binding CanAdapt}" Style="{StaticResource SoftButton}" Margin="0,0,6,0"/><Button Content="生成铺满布局" Click="FillBackgroundAdaptation" IsEnabled="{Binding CanAdapt}" Style="{StaticResource SoftButton}" ToolTip="生成独立布局，仅将背景等比裁切铺满，文字和时钟保持比例，原布局保留。"/></WrapPanel></StackPanel></Expander>
   <Expander x:Name="BatchOptions" Grid.Column="1" Header="多设备应用" IsEnabled="{Binding CanConfigure}"><ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,10"><CheckBox IsChecked="{Binding Selected}"><TextBlock Text="{Binding PreviewLabel}" TextWrapping="Wrap"/></CheckBox><CheckBox IsChecked="{Binding Confirmed}" IsEnabled="{Binding CanConfirm}" Content="已核对设备与参数" Margin="18,6,0,0"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="#8C9AB1" Margin="18,4,0,0"/><TextBlock Text="{Binding CapabilityNotice}" TextWrapping="Wrap" Foreground="#8C9AB1" Margin="18,4,0,0"/><TextBlock Text="{Binding AppliedTheme}" Margin="18,4,0,0"/><TextBlock Text="{Binding OutputStatus}" Foreground="#4C85F6" Margin="18,4,0,0"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8C9AB1" Margin="18,4,0,0"/><Button Content="停止该设备输出" Command="{Binding StopCommand}" Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="18,5,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button x:Name="ApplySelected" Content="{Binding BatchApplyLabel}" Command="{Binding ApplySelectedCommand}" Style="{StaticResource SoftButton}" Margin="0,8,0,0" ToolTip="在编辑器打开时先保存，再逐台应用；各设备结果独立记录"/></StackPanel></ScrollViewer></Expander>
  </Grid>
  <Border Grid.Row="3" Background="#172233" CornerRadius="12" Padding="12"><scene:PreviewHost AspectRatio="{Binding PreviewAspect}"><scene:SceneView x:Name="PreviewSurface" Scene="{Binding PreviewScene}" AspectRatioOverride="{Binding PreviewAspect}"/></scene:PreviewHost></Border>
  <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#A36B21" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#8C9AB1"/><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding Device}" FontWeight="SemiBold" Margin="0,0,10,0"/><TextBlock Text="{Binding State}" Foreground="#4C85F6" Margin="0,0,10,0"/><TextBlock Text="{Binding Theme}" Margin="0,0,10,0"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8C9AB1"/></WrapPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
   <DockPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="{Binding Readiness}" VerticalAlignment="Center" Foreground="#8C9AB1"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="仅保存" Command="{Binding SaveOnlyCommand}" Visibility="{Binding HasSaveAction, Converter={StaticResource Visible}}" Style="{StaticResource SoftButton}" Margin="0,0,10,0"/><Button x:Name="ApplyTarget" Content="{Binding ApplyLabel}" Command="{Binding ApplyTargetCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel>
  </Grid>
 </Grid>
</Window>

