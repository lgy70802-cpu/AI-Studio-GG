<UserControl x:Class="DeskDisplay.App.Views.AccountView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Typography.xaml"/>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Cards.xaml"/>
 </ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolVisible"/></ResourceDictionary></UserControl.Resources>
 <Grid Margin="32,28,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="个人中心" Style="{StaticResource Text.PageTitle}"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource SoftCard}" Padding="28" Margin="0,18,0,0" MaxWidth="620" HorizontalAlignment="Stretch" VerticalAlignment="Top">
   <StackPanel MaxWidth="480">
    <StackPanel Visibility="{Binding Account.IsLoggedOut, Converter={StaticResource BoolVisible}}">
     <TextBlock Text="D92 Studio 账号" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="登录后同步收藏、已购资源和 VIP 权益。" Style="{StaticResource Text.Secondary}" Margin="0,6,0,18"/>
     <TextBox Text="{Binding Account.Email, UpdateSourceTrigger=PropertyChanged}" Padding="12,9" Margin="0,0,0,10" ToolTip="邮箱"/>
     <PasswordBox PasswordChanged="OnPasswordChanged" Padding="12,9" Margin="0,0,0,14" ToolTip="密码至少 8 位"/>
     <WrapPanel><Button Content="登录" Command="{Binding Account.LoginCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="注册新账号" Command="{Binding Account.RegisterCommand}" Style="{StaticResource SoftButton}"/></WrapPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding Account.IsLoggedIn, Converter={StaticResource BoolVisible}}">
     <TextBlock Text="{Binding Account.Profile.Email}" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Account.Membership}" Foreground="{StaticResource Brush.Primary}" Margin="0,8,0,18"/>
     <Button Content="退出登录" Command="{Binding Account.LogoutCommand}" Style="{StaticResource SoftButton}" HorizontalAlignment="Left"/>
    </StackPanel>
    <TextBlock Text="{Binding Account.Status}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,18,0,0"/>
   </StackPanel>
  </Border></ScrollViewer>
 </Grid>
</UserControl>
