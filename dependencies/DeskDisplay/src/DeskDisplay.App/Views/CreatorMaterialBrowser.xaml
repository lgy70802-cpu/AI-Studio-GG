<Window x:Class="DeskDisplay.App.Views.CreatorMaterialBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:scene="clr-namespace:DeskDisplay.Display.Views;assembly=DeskDisplay.Display" Title="选择素材" Width="960" Height="720" MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Typography.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Cards.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><TextBlock Text="选择素材" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="{Binding Editor.MaterialEmptyText}" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Editor.IsMaterialEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,14"><TextBox Text="{Binding Editor.MaterialSearch, UpdateSourceTrigger=PropertyChanged, Delay=180}" Width="190" Padding="7" ToolTip="名称、标签或分类" Margin="0,0,8,6"/><ComboBox ItemsSource="{Binding Editor.AssetOrientations}" SelectedItem="{Binding Editor.AssetOrientation}" Width="130" Margin="0,0,8,6"/><ComboBox ItemsSource="{Binding Editor.AssetOrigins}" SelectedItem="{Binding Editor.AssetOrigin}" Width="130" Margin="0,0,8,6"/><ComboBox ItemsSource="{Binding Editor.AssetCategories}" SelectedItem="{Binding Editor.AssetCategory}" Width="130" Margin="0,0,8,6"/><ComboBox ItemsSource="{Binding Editor.AssetSubcategories}" SelectedItem="{Binding Editor.AssetSubcategory}" Width="130" Margin="0,0,8,6"/></WrapPanel>
  <ListBox x:Name="AssetsList" MouseDoubleClick="DoubleAdd" Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource SoftCard.Flat}" Margin="0,0,8,8" Padding="8"><StackPanel><scene:PreviewHost AspectRatio="{Binding LibraryAspectRatio}" MaxHeight="210"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></scene:PreviewHost><TextBlock Text="文件失效，请先修复路径" Foreground="#D45A68" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,3" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Metadata}" Style="{StaticResource Text.Secondary}"/><TextBlock Text="{Binding CarouselCategory}" Style="{StaticResource Text.Secondary}"/><TextBlock Text="{Binding CreatorUsageHint}" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="大图预览" Click="PreviewAsset" IsEnabled="{Binding HasSelection}" Style="{StaticResource SoftButton}" Margin="0,0,8,0"/><Button Content="添加到画布" Click="Add" IsEnabled="{Binding HasSelection}" Style="{StaticResource PrimaryButton}"/><CheckBox Content="替换时保留裁剪" IsChecked="{Binding KeepCrop}" IsEnabled="{Binding CanReplace}" VerticalAlignment="Center" Margin="8,0"/><Button Content="替换当前素材" Click="Replace" IsEnabled="{Binding CanReplace}" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/><Button Content="关闭" Click="Cancel" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="上一页" Command="{Binding Previous}" Style="{StaticResource SoftButton}"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0"/><Button Content="下一页" Command="{Binding Next}" Style="{StaticResource SoftButton}"/></StackPanel></DockPanel>
 </Grid>
</Window>
