<UserControl x:Class="DeskDisplay.App.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DeskDisplay.App.Views" xmlns:scene="clr-namespace:DeskDisplay.Display.Views;assembly=DeskDisplay.Display" Background="Transparent">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Typography.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Cards.xaml"/>
 </ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/><local:CachedImageConverter x:Key="CachedImage"/>
  <Style x:Key="ScopeList" TargetType="ListBox" BasedOn="{StaticResource FilterList}"/>
  <Style x:Key="PillList" TargetType="ListBox" BasedOn="{StaticResource FilterList}"/>
  <DataTemplate x:Key="WallpaperCard"><Border x:Name="Card" Background="White" CornerRadius="10" Padding="0" Margin="0,0,16,16" ClipToBounds="True"><StackPanel><Grid><scene:PreviewHost AspectRatio="{Binding LibraryAspectRatio}"><scene:PreviewHost.Style><Style TargetType="scene:PreviewHost"><Setter Property="HorizontalAlignment" Value="Stretch"/><Style.Triggers><DataTrigger Binding="{Binding IsPortrait}" Value="True"><Setter Property="Width" Value="122"/><Setter Property="HorizontalAlignment" Value="Center"/></DataTrigger></Style.Triggers></Style></scene:PreviewHost.Style><Border Background="#16233B" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border></scene:PreviewHost><Button Style="{StaticResource SoftButton}" Padding="0" AutomationProperties.Name="查看壁纸详情" Command="{Binding DataContext.Library.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Card}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="{Binding FavoriteLabel}" Command="{Binding DataContext.Library.FavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SoftButton}" Padding="9,5" Margin="0,0,6,0"/><Button Content="☆" Command="{Binding DataContext.ToggleHomePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" ToolTip="固定到首页 / 取消固定"/><Button Content="{Binding UseLabel}" Click="UseSavedTheme" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="应用到当前设备"/><Button Content="选择设备" ToolTip="{Binding DataContext.QuickDevice.Alias, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=当前目标：{0}, TargetNullValue=尚未选择目标}" Tag="choose" Click="UseSavedTheme" Style="{StaticResource SoftButton}" Margin="6,0,0,0"/></StackPanel><Border VerticalAlignment="Top" Background="#990F1B2D" Padding="10,6" IsHitTestVisible="False"><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Border></Grid></StackPanel></Border></DataTemplate>
  <DataTemplate x:Key="SavedThemeCard"><Border x:Name="ThemeCardRoot" Focusable="True" Background="White" CornerRadius="10" Padding="10" Margin="0,0,16,16"><StackPanel><Grid><scene:PreviewHost AspectRatio="{Binding Aspect}" MaxHeight="260"><Border Background="#EDF2F8"><Image Source="{Binding CoverUri, Converter={StaticResource CachedImage}}" Stretch="Uniform"/></Border></scene:PreviewHost><WrapPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=ThemeCardRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ThemeCardRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button Content="☆ 固定 / 取消" Command="{Binding DataContext.ToggleHomePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SoftButton}" Margin="0,0,6,0"/><Button Content="加入混合轮播" Command="{Binding DataContext.AddToMixedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SoftButton}" Margin="0,0,6,0"/><Button Content="使用主题" Click="UseSavedTheme" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/><Button Content="选择设备" ToolTip="{Binding DataContext.QuickDevice.Alias, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=当前目标：{0}, TargetNullValue=尚未选择目标}" Tag="choose" Click="UseSavedTheme" Style="{StaticResource SoftButton}" Margin="6,0,0,0"/><Button Content="编辑" Command="{Binding DataContext.Creator.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Click="EditSavedTheme" Style="{StaticResource SoftButton}" Margin="0,0,6,0"/><Button Content="{Binding FavoriteLabel}" Click="FavoriteTheme" Style="{StaticResource SoftButton}"/></WrapPanel></Grid><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="3,10,0,4" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate>  <DataTemplate x:Key="DemoCard"><Border Background="White" CornerRadius="10" Margin="0,0,16,16" ClipToBounds="True"><StackPanel><scene:PreviewHost AspectRatio="4"><Grid Background="{Binding Background}"><Ellipse Width="250" Height="250" Fill="{Binding Accent}" Opacity="0.42" HorizontalAlignment="Right" Margin="0,-140,-50,0"/></Grid></scene:PreviewHost><StackPanel Margin="14,10,14,13"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="壁纸 · 演示案例" Style="{StaticResource Text.Secondary}" Margin="0,5,0,0"/></StackPanel></StackPanel></Border></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="32,28,32,24">
  <Grid Visibility="{Binding Library.IsGallery, Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="资源检查" Command="{Binding OpenResourceMaintenanceCommand}" Style="{StaticResource SoftButton}" Margin="0,0,8,0"/><Button Content="批量管理" Command="{Binding Library.ToggleBatchModeCommand}" Style="{StaticResource SoftButton}" Margin="0,0,8,0"/><Button Content="＋ 导入壁纸" Command="{Binding Library.ImportCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel><StackPanel><TextBlock Text="我的资源库" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="{Binding Library.LibrarySummary}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/></StackPanel></DockPanel>
   <ListBox Grid.Row="1" ItemsSource="{Binding Library.ResourceScopes}" SelectedItem="{Binding Library.SelectedResourceScope}" Style="{StaticResource ScopeList}" Margin="0,0,0,10"/>
   <Border Grid.Row="2" Style="{StaticResource SoftCard.Flat}" Padding="14" Margin="0,0,0,14"><StackPanel>
    <DockPanel><TextBox DockPanel.Dock="Right" Text="{Binding Library.Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="250" Padding="10,7" ToolTip="搜索名称、分类或标签"/><ListBox ItemsSource="{Binding Library.ResourceTypes}" SelectedItem="{Binding Library.SelectedResourceType}" Style="{StaticResource PillList}"/></DockPanel><ListBox ItemsSource="{Binding Library.BrowseOrientations}" SelectedItem="{Binding Library.BrowseOrientation}" Style="{StaticResource PillList}" AutomationProperties.Name="素材浏览方向" ToolTip="仅筛选资源，不更改设备方向"/>
    <StackPanel Visibility="{Binding Library.ShowCategoryFilters, Converter={StaticResource Visible}}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="一级分类" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/><ListBox Grid.Column="1" ItemsSource="{Binding Library.Categories}" SelectedItem="{Binding Library.SelectedCategory}" Style="{StaticResource PillList}"/></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="二级分类" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/><ListBox Grid.Column="1" ItemsSource="{Binding Library.Subcategories}" SelectedItem="{Binding Library.SelectedSubcategory}" Style="{StaticResource PillList}"/></Grid></StackPanel>
    <WrapPanel Visibility="{Binding Library.IsBatchMode, Converter={StaticResource Visible}}" Margin="0,12,0,0"><TextBlock Text="{Binding Library.SelectedCount, StringFormat=已选择 {0} 项}" VerticalAlignment="Center" Margin="0,0,12,8"/><TextBox Text="{Binding Library.BatchCategory}" Width="120" ToolTip="批量一级分类" Margin="0,0,8,8"/><TextBox Text="{Binding Library.BatchSubcategory}" Width="120" ToolTip="批量二级分类" Margin="0,0,8,8"/><TextBox Text="{Binding Library.BatchTags}" Width="160" ToolTip="批量标签" Margin="0,0,8,8"/><Button Content="批量保存" Command="{Binding Library.BatchUpdateCommand}" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/><Button Content="批量移除" Command="{Binding Library.BatchRemoveCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/><Button Content="退出批量管理" Command="{Binding Library.ToggleBatchModeCommand}" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/></WrapPanel>
   </StackPanel></Border>
   <ScrollViewer x:Name="GalleryScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnGalleryScrollChanged"><StackPanel><StackPanel Visibility="{Binding Library.ShowThemeSection, Converter={StaticResource Visible}}" Margin="0,0,0,16"><TextBlock Text="已保存主题" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Library.VisibleThemes}" ItemTemplate="{StaticResource SavedThemeCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="上一页" IsEnabled="{Binding Library.CanPreviousThemePage}" Click="PreviousThemes" Style="{StaticResource SoftButton}"/><TextBlock Text="{Binding Library.ThemePageLabel}" VerticalAlignment="Center" Margin="12,0"/><Button Content="下一页" IsEnabled="{Binding Library.CanNextThemePage}" Click="NextThemes" Style="{StaticResource SoftButton}"/></StackPanel></StackPanel><ItemsControl ItemsSource="{Binding Library.VisibleItems}" ItemTemplate="{StaticResource WallpaperCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><StackPanel Visibility="{Binding Library.ShowDemoGallery, Converter={StaticResource Visible}}"><TextBlock Text="以下为不可操作的布局演示。导入真实资源后会自动隐藏。" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding DemoWallpapers}" ItemTemplate="{StaticResource DemoCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel><Border Visibility="{Binding Library.ShowFilteredEmpty, Converter={StaticResource Visible}}" Padding="30"><StackPanel HorizontalAlignment="Center"><TextBlock Text="暂无资源" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Library.EmptyStateMessage}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel></Border><TextBlock Visibility="{Binding Library.ShowWallpaperResources, Converter={StaticResource Visible}}" Text="{Binding Library.LoadStatus}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,8,0,18"/></StackPanel></ScrollViewer>
   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding Library.ShowPagination, Converter={StaticResource Visible}}"><Button Content="上一页" Command="{Binding Library.PreviousPageCommand}" Style="{StaticResource SoftButton}"/><TextBlock Text="{Binding Library.PageLabel}" Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/><Button Content="下一页" Command="{Binding Library.NextPageCommand}" Style="{StaticResource SoftButton}"/></StackPanel>
  </Grid>
  <ScrollViewer Visibility="{Binding Library.IsDetails, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto"><StackPanel><Button Content="‹ 返回资源库" Command="{Binding Library.BackCommand}" Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,0,0,14"/><Border Style="{StaticResource SoftCard}" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><scene:PreviewHost AspectRatio="{Binding Library.Selected.LibraryAspectRatio}"><Border Background="#111A29" CornerRadius="10" ClipToBounds="True"><Image Source="{Binding Library.Selected.DetailImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border></scene:PreviewHost><StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="{Binding Library.Selected.Name}" Style="{StaticResource Text.PageTitle}" TextWrapping="Wrap"/><TextBlock Text="{Binding Library.Selected.Metadata}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,18"/><WrapPanel><Button Content="{Binding Usb.VideoPauseLabel}" Command="{Binding Usb.VideoPauseCommand}" Visibility="{Binding Usb.IsVideoRunning, Converter={StaticResource Visible}}" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/><Button Content="预览" Command="{Binding Library.PreviewCommand}" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/><Button DataContext="{Binding Library.Selected}" Content="{Binding UseLabel}" ToolTip="应用到当前设备" Click="UseSavedTheme" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button DataContext="{Binding Library.Selected}" Content="选择设备" ToolTip="{Binding DataContext.QuickDevice.Alias, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=当前目标：{0}, TargetNullValue=尚未选择目标}" Tag="choose" Click="UseSavedTheme" Style="{StaticResource SoftButton}" Margin="6,0,0,0"/><Button Content="应用到副屏" Command="{Binding Library.ApplyCommand}" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/></WrapPanel><TextBox Text="{Binding Library.EditName}" Margin="0,14,0,8"/><TextBox Text="{Binding Library.EditCategory}" Margin="0,0,0,8" ToolTip="一级分类"/><TextBox Text="{Binding Library.EditSubcategory}" Margin="0,0,0,8" ToolTip="二级分类"/><TextBox Text="{Binding Library.EditTags}" Margin="0,0,0,12" ToolTip="标签"/><WrapPanel><Button Content="保存信息" Command="{Binding Library.SaveMetadataCommand}" Style="{StaticResource SoftButton}" Margin="0,0,8,0"/><Button Content="从资源库移除" Command="{Binding Library.RemoveCommand}" Style="{StaticResource SoftButton}"/></WrapPanel></StackPanel></Grid></Border><Border Style="{StaticResource SoftCard.Flat}" Margin="0,16,0,0"><DockPanel><TextBlock Text="{Binding Library.Status}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{Binding Library.Selected.FavoriteLabel}" Command="{Binding Library.FavoriteCommand}" Style="{StaticResource SoftButton}"/><Button Content="{Binding Library.PlaylistAction}" Command="{Binding Library.PlaylistCommand}" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/><Button Content="轮播前移" Command="{Binding Library.MoveUpCommand}" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/><Button Content="轮播后移" Command="{Binding Library.MoveDownCommand}" Style="{StaticResource SoftButton}" Margin="8,0,0,0"/></StackPanel></DockPanel></Border></StackPanel></ScrollViewer>
 </Grid>
</UserControl>
