<UserControl x:Class="DeskDisplay.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Colors.xaml"/><ResourceDictionary Source="/DeskDisplay.App;component/Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid Margin="0,24,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <Button Style="{DynamicResource SoftButton}" DockPanel.Dock="Right" Content="刷新显示器" Command="{Binding RefreshCommand}"
                    Padding="18,10" Margin="16,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="RefreshDisplaysButton" />
            <TextBlock Text="显示器管理" FontSize="26" FontWeight="SemiBold" Foreground="#172233" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#52647A" Margin="0,16,0,20"
                   AutomationProperties.AutomationId="DisplayStatus" />
        <Border Grid.Row="2" Background="#E8F0F8" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="当前目标副屏" FontWeight="SemiBold" FontSize="16" Foreground="#172233" />
                <TextBlock Text="{Binding TargetName}" Margin="0,6,0,4" FontSize="18" Foreground="#172233" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="TargetDisplayName" />
                <WrapPanel>
                    <TextBlock Text="{Binding TargetResolution}" Margin="0,0,20,4" Foreground="#345C85" />
                    <TextBlock Text="{Binding TargetConnectionStatus}" Foreground="#345C85" Margin="0,0,0,4"
                               AutomationProperties.AutomationId="TargetConnectionStatus" />
                </WrapPanel>
                <TextBlock Text="{Binding TargetNotice}" Foreground="#52647A" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ListBox Grid.Row="3" ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                 AutomationProperties.AutomationId="DisplayCards">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,4,12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="SelectionBorder" BorderBrush="Transparent" BorderThickness="2" CornerRadius="14" Padding="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#9BB5D0" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#345C85" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{Binding FriendlyName}" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" Foreground="#172233" />
                                <TextBlock Text="{Binding DeviceName}" Foreground="#65748A" Margin="0,6,0,14" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <TextBlock Margin="0,0,24,8" Foreground="#345C85">
                                        <Run Text="分辨率：" /><Run Text="{Binding Width, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Height, Mode=OneWay}" /><Run Text=" px" />
                                    </TextBlock>
                                    <TextBlock Margin="0,0,24,8" Foreground="#345C85">
                                        <Run Text="坐标：(" /><Run Text="{Binding X, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Y, Mode=OneWay}" /><Run Text=") px" />
                                    </TextBlock>
                                    <TextBlock Foreground="#345C85" Margin="0,0,0,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="副显示器" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Text" Value="主显示器" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </WrapPanel>
                                <TextBlock Text="{Binding DeviceId, TargetNullValue=设备标识不可用}" Foreground="#65748A" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <WrapPanel>
                <Button Style="{DynamicResource SoftButton}" Content="设为目标副屏" Command="{Binding SetTargetCommand}" Padding="16,9" Margin="0,0,12,4"
                        AutomationProperties.AutomationId="SetTargetDisplayButton" />
                <Button Style="{DynamicResource SoftButton}" Content="取消设为目标副屏" Command="{Binding ClearTargetCommand}" Padding="16,9" Margin="0,0,0,4"
                        AutomationProperties.AutomationId="ClearTargetDisplayButton" />
                <Button Style="{DynamicResource SoftButton}" Content="应用当前预览" Command="{Binding DataContext.Workspace.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="16,9" Margin="12,0,12,4"
                        AutomationProperties.AutomationId="TestDisplayButton" />
                <Button Style="{DynamicResource SoftButton}" Content="停止显示" Command="{Binding DataContext.Workspace.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="16,9" Margin="0,0,0,4"
                        AutomationProperties.AutomationId="CloseRenderButton" />
            </WrapPanel>
            <TextBlock Text="{Binding RenderStatus}" TextWrapping="Wrap" Foreground="#52647A" Margin="0,4,0,0"
                       AutomationProperties.AutomationId="RenderStatus" />
            <TextBlock Text="{Binding TargetActionStatus}" TextWrapping="Wrap" Foreground="#52647A" Margin="0,4,0,0"
                       AutomationProperties.AutomationId="TargetActionStatus" />
        </StackPanel>
    </Grid>
</UserControl>
