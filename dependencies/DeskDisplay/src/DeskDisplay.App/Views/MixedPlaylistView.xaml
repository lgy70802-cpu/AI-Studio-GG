<UserControl x:Class="DeskDisplay.App.Views.MixedPlaylistView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DeskDisplay.App.Views">
 <UserControl.Resources><local:CachedImageConverter x:Key="CoverImage"/></UserControl.Resources>
 <Grid Margin="0,16,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
    <TextBlock Text="新建列表" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBox x:Name="NewListName" MaxLength="60" Padding="10,8" ToolTip="输入列表名称"/>
    <WrapPanel Margin="0,8,0,0"><Button Content="重命名" Click="RenameList" Style="{DynamicResource SoftButton}" Margin="0,0,4,4"/><Button Content="复制" Click="CopyList" Style="{DynamicResource SoftButton}" Margin="0,0,4,4"/><Button Content="删除列表" Click="DeleteList" Style="{DynamicResource SoftButton}"/></WrapPanel><Button Content="＋ 新建列表" Click="CreateNamedList" Style="{DynamicResource SoftButton}" Margin="0,8,0,0"/>
   </StackPanel>
   <ListBox ItemsSource="{Binding NamedLists}" SelectedItem="{Binding SelectedList, Mode=OneWay}" SelectionChanged="SelectNamedList" IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
  <Border Grid.Column="2" Style="{DynamicResource SoftCard.Flat}" Padding="20">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="{Binding SelectedList.Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ListSummary}" Foreground="#748198" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
     <TextBlock Text="输出设备" VerticalAlignment="Center" Margin="0,0,8,8"/>
     <ComboBox Style="{DynamicResource SoftSelector}" ItemsSource="{Binding Devices}" SelectedItem="{Binding Target}" DisplayMemberPath="PreviewLabel" IsEnabled="{Binding CanEdit}" Width="220" Margin="0,0,12,8"/>
     <CheckBox Content="随机播放" IsChecked="{Binding Shuffle}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,12,8"/>
     <Button Content="开始轮播" Click="Start" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8"/>
     <Button Content="{Binding PauseLabel}" Click="Pause" Style="{DynamicResource SoftButton}" Margin="0,0,8,8"/>
     <Button Content="下一项" Click="Next" Style="{DynamicResource SoftButton}" Margin="0,0,8,8"/>
     <Button Content="停止切换" Click="Stop" Style="{DynamicResource SoftButton}" Margin="0,0,0,8"/>
    </WrapPanel>
    <Border Grid.Row="2" Background="#EDF2FF" CornerRadius="10" Padding="14" Margin="0,0,0,16">
     <StackPanel><TextBlock Text="{Binding CurrentName}" FontWeight="SemiBold"/><WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding CountdownText}" Foreground="#4268EF" Margin="0,0,16,0"/><TextBlock Text="{Binding NextName, StringFormat=下一项 {0}}" Foreground="#748198"/></WrapPanel></StackPanel>
    </Border>
    <Grid Grid.Row="3">
     <DataGrid Style="{DynamicResource SoftDataGrid}" x:Name="Rows" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="{Binding IsRunning}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" Drop="DropItem" RowHeight="104" HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="顺序 / 内容" Width="*" MinWidth="230" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Background="#EDF2F8" CornerRadius="8" Height="72"><Grid><Image Source="{Binding Wallpaper.Thumbnail}" Stretch="Uniform"/><Image Source="{Binding ThemeCover, Converter={StaticResource CoverImage}}" Stretch="Uniform"/></Grid></Border>
         <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Kind}" Foreground="#748198" Margin="0,6,0,0"/></StackPanel>
        </Grid>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridCheckBoxColumn Header="播完切换" Binding="{Binding PlayToEnd, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
       <DataGridTextColumn Header="停留秒数" Binding="{Binding Seconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="85"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="列表为空，请在下方选择内容加入" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#748198" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,16,0,0">
     <WrapPanel IsEnabled="{Binding CanEdit}"><TextBox Text="{Binding CandidateSearch, UpdateSourceTrigger=PropertyChanged}" Width="150" Padding="8" ToolTip="搜索可添加内容" Margin="0,0,8,8"/><ComboBox Style="{DynamicResource SoftSelector}" x:Name="Candidate" ItemsSource="{Binding FilteredCandidates}" DisplayMemberPath="Name" Width="220" Margin="0,0,8,8"/><Button Content="加入列表" Click="Add" Style="{DynamicResource SoftButton}" Margin="0,0,8,8"/><Button Content="上移" Click="Up" Style="{DynamicResource SoftButton}" Margin="0,0,8,8"/><Button Content="下移" Click="Down" Style="{DynamicResource SoftButton}" Margin="0,0,8,8"/><Button Content="移出列表" Click="Remove" Style="{DynamicResource SoftButton}" Margin="0,0,0,8"/></WrapPanel>
     <WrapPanel IsEnabled="{Binding CanEdit}" Margin="0,4,0,8"><TextBox x:Name="AllSeconds" Text="30" Width="70" ToolTip="10至86400秒" Padding="8"/><Button Content="统一停留秒数" Click="SetAllSeconds" Style="{DynamicResource SoftButton}" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#748198"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
